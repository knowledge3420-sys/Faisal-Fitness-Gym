# Optional: fixed origin used for canonical / Open Graph / sitemap URLs.
# If left empty, the site derives the origin from the incoming request host
# at runtime, so it works out of the box on Vercel (preview + production).
NEXT_PUBLIC_SITE_URL=

# Reserved for future integrations (e.g. a YouTube Data API key to auto-list
# channel videos on the /media page).
NEXT_PUBLIC_YOUTUBE_API_KEY=
